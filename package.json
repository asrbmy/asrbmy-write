{
  "name": "asrbmy-write",
  "version": "1.0.0",
  "description": "ASRBMY Write \u2014 a static writing and publishing site for GitHub Pages.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/check.js",
    "dev": "node scripts/serve.js --watch",
    "preview": "node scripts/serve.js",
    "test": "npm run test:unit && npm run build && npm run check",
    "write": "node writer/server.js",
    "test:unit": "node tests/regression.mjs",
    "links": "node scripts/linkcheck.js",
    "import": "node scripts/import.js",
    "build:drafts": "node scripts/build.js --drafts",
    "dev:drafts": "node scripts/serve.js --watch --drafts",
    "a11y": "node scripts/check.js"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "highlight.js": "^11.10.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0"
  },
  "optionalDependencies": {
    "fast-xml-parser": "^5.11.2",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4"
  }
}
